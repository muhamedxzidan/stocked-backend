generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Fixed operational roles. Authorization is enforced by backend services.
enum UserRole {
  ADMIN
  WAREHOUSE_KEEPER
  EMPLOYEE
  MERCHANT

  @@map("user_role")
}

// A person account. Merchant ownership and account creation are distinct relations.
model User {
  id                        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                     String                @unique @db.VarChar(254)
  displayName               String                @map("display_name") @db.VarChar(150)
  passwordHash              String                @map("password_hash") @db.Text
  role                      UserRole
  merchantId                String?               @map("merchant_id") @db.Uuid
  isActive                  Boolean               @default(true) @map("is_active")
  mustChangePassword        Boolean               @default(true) @map("must_change_password")
  createdById               String?               @map("created_by_id") @db.Uuid
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  merchant                  Merchant?             @relation("MerchantAccounts", fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator                   User?                 @relation("AccountCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdUsers              User[]                @relation("AccountCreator")
  createdMerchants          Merchant[]            @relation("MerchantCreator")
  receivedReceipts          Receipt[]             @relation("ReceiptReceiver")
  performedStockAdjustments StockAdjustment[]     @relation("AdjustmentActor")
  sessions                  Session[]
  createdItems              Item[]                @relation("ItemCreator")
  stockMovements            StockMovement[]
  registeredShipments       Shipment[]            @relation("ShipmentRegistrar")
  preparedShipments         ShipmentPreparation[] @relation("ShipmentPreparer")
  dispatchedShipments       ShipmentDispatch[]    @relation("ShipmentDispatcher")
  receivedReturns           ReturnReceipt[]       @relation("ReturnReceiver")
  inspectedReturns          ReturnInspection[]    @relation("ReturnInspector")
  reviewedReturns           ReturnReview[]        @relation("ReturnReviewer")

  @@index([merchantId])
  @@index([role, isActive])
  @@map("users")
}

// The business owning goods, independent from its read-only login accounts.
model Merchant {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String                @unique @db.VarChar(8)
  name                 String                @db.VarChar(200)
  phone                String                @db.VarChar(32)
  isActive             Boolean               @default(true) @map("is_active")
  createdById          String                @map("created_by_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  creator              User                  @relation("MerchantCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accounts             User[]                @relation("MerchantAccounts")
  items                Item[]
  itemCodeSequence     ItemCodeSequence?
  receipts             Receipt[]
  balances             InventoryBalance[]
  stockMovements       StockMovement[]
  stockAdjustments     StockAdjustment[]
  receiptLines         ReceiptLine[]
  shipments            Shipment[]
  shipmentLines        ShipmentLine[]
  shipmentPreparations ShipmentPreparation[]
  shipmentDispatches   ShipmentDispatch[]
  returns              ReturnReceipt[]

  @@map("merchants")
}

// Only a token digest is persisted. Expiry/idle/account checks belong to auth services.
model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

// Shared, privacy-preserving authentication attempt counters; no raw identifiers.
model LoginAttemptBucket {
  keyDigest       String   @id @map("key_digest") @db.Char(64)
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)
  attemptCount    Int      @map("attempt_count")

  @@index([expiresAt])
  @@map("login_attempt_buckets")
}

// Catalog identity only. Quantities will originate from stock movements.
model Item {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId     String             @map("merchant_id") @db.Uuid
  ordinal        BigInt
  code           String             @unique @db.VarChar(40)
  name           String             @db.VarChar(200)
  brand          String?            @db.VarChar(100)
  color          String?            @db.VarChar(100)
  weightKg       Decimal            @map("weight_kg") @db.Decimal(12, 3)
  notes          String?            @db.VarChar(2000)
  isActive       Boolean            @default(true) @map("is_active")
  createdById    String             @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  merchant       Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator        User               @relation("ItemCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  receiptLines   ReceiptLine[]
  balances       InventoryBalance[]
  adjustments    StockAdjustment[]
  stockMovements StockMovement[]
  shipmentLines  ShipmentLine[]

  @@unique([merchantId, ordinal])
  @@unique([id, merchantId])
  @@index([merchantId, isActive, createdAt, id])
  @@map("items")
}

model ItemCodeSequence {
  merchantId String   @id @map("merchant_id") @db.Uuid
  lastValue  BigInt   @default(0) @map("last_value")
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("item_code_sequences")
}

enum ReceiptLineCondition {
  GOOD
  NOTED

  @@map("receipt_line_condition")
}

enum ReceiptIssueType {
  BROKEN
  SCRATCH
  DAMAGED
  OTHER

  @@map("receipt_issue_type")
}

enum StockMovementKind {
  RECEIPT_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  SHIPMENT_OUT
  RETURN_IN

  @@map("stock_movement_kind")
}

enum StockAdjustmentDirection {
  IN
  OUT

  @@map("stock_adjustment_direction")
}

// Stable dimension for stock; MAIN is provisioned by the migration.
model Warehouse {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String                @unique @db.VarChar(12)
  name                 String                @db.VarChar(120)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  receipts             Receipt[]
  balances             InventoryBalance[]
  movements            StockMovement[]
  adjustments          StockAdjustment[]
  receiptLines         ReceiptLine[]
  shipments            Shipment[]
  shipmentLines        ShipmentLine[]
  shipmentCodeSequence ShipmentCodeSequence?
  shipmentPreparations ShipmentPreparation[]
  shipmentDispatches   ShipmentDispatch[]
  returns              ReturnReceipt[]

  @@map("warehouses")
}

model Receipt {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId            String        @map("warehouse_id") @db.Uuid
  merchantId             String        @map("merchant_id") @db.Uuid
  merchantNameSnapshot   String        @map("merchant_name_snapshot") @db.VarChar(200)
  receivedById           String        @map("received_by_id") @db.Uuid
  receivedByNameSnapshot String        @map("received_by_name_snapshot") @db.VarChar(150)
  receivedAt             DateTime      @map("received_at") @db.Timestamptz(3)
  notes                  String?       @db.VarChar(2000)
  idempotencyKey         String        @map("idempotency_key") @db.Uuid
  requestHash            String        @map("request_hash") @db.Char(64)
  warehouse              Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  merchant               Merchant      @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  receiver               User          @relation("ReceiptReceiver", fields: [receivedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines                  ReceiptLine[]

  @@unique([warehouseId, idempotencyKey])
  @@unique([id, warehouseId, merchantId])
  @@index([warehouseId, merchantId, receivedAt, id])
  @@index([warehouseId, receivedById, receivedAt, id])
  @@map("receipts")
}

model ReceiptLine {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId        String               @map("receipt_id") @db.Uuid
  warehouseId      String               @map("warehouse_id") @db.Uuid
  merchantId       String               @map("merchant_id") @db.Uuid
  itemId           String               @map("item_id") @db.Uuid
  position         Int
  itemCodeSnapshot String               @map("item_code_snapshot") @db.VarChar(40)
  itemNameSnapshot String               @map("item_name_snapshot") @db.VarChar(200)
  quantity         Int
  condition        ReceiptLineCondition
  issueType        ReceiptIssueType?    @map("issue_type")
  notes            String?              @db.VarChar(2000)
  receipt          Receipt              @relation(fields: [receiptId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  item             Item                 @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  warehouse        Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  merchant         Merchant             @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  movement         StockMovement?       @relation("ReceiptLineMovement")

  @@unique([receiptId, position])
  @@unique([id, warehouseId, merchantId, itemId, quantity])
  @@index([warehouseId, merchantId, itemId, receiptId])
  @@map("receipt_lines")
}

model InventoryBalance {
  warehouseId String    @map("warehouse_id") @db.Uuid
  merchantId  String    @map("merchant_id") @db.Uuid
  itemId      String    @map("item_id") @db.Uuid
  quantity    Int       @default(0)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([warehouseId, itemId])
  @@unique([warehouseId, itemId, merchantId])
  @@index([merchantId, itemId])
  @@map("inventory_balances")
}

model StockAdjustment {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId             String                   @map("warehouse_id") @db.Uuid
  merchantId              String                   @map("merchant_id") @db.Uuid
  merchantNameSnapshot    String                   @map("merchant_name_snapshot") @db.VarChar(200)
  itemId                  String                   @map("item_id") @db.Uuid
  itemCodeSnapshot        String                   @map("item_code_snapshot") @db.VarChar(40)
  itemNameSnapshot        String                   @map("item_name_snapshot") @db.VarChar(200)
  referenceMovementId     String?                  @map("reference_movement_id") @db.Uuid
  stocktakeLineId         String?                  @unique @map("stocktake_line_id") @db.Uuid
  direction               StockAdjustmentDirection
  quantity                Int
  quantityDelta           Int                      @map("quantity_delta")
  reason                  String                   @db.VarChar(2000)
  performedById           String                   @map("performed_by_id") @db.Uuid
  performedByNameSnapshot String                   @map("performed_by_name_snapshot") @db.VarChar(150)
  recordedAt              DateTime                 @map("recorded_at") @db.Timestamptz(3)
  idempotencyKey          String                   @map("idempotency_key") @db.Uuid
  requestHash             String                   @map("request_hash") @db.Char(64)
  warehouse               Warehouse                @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  merchant                Merchant                 @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  item                    Item                     @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor                   User                     @relation("AdjustmentActor", fields: [performedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  referenceMovement       StockMovement?           @relation("AdjustmentReference", fields: [referenceMovementId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  movement                StockMovement?           @relation("AdjustmentMovement")

  @@unique([warehouseId, idempotencyKey])
  @@unique([id, warehouseId, merchantId, itemId, quantityDelta])
  @@index([warehouseId, merchantId, recordedAt, id])
  @@index([warehouseId, performedById, recordedAt, id])
  @@map("stock_adjustments")
}

model StockMovement {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId             String                @map("warehouse_id") @db.Uuid
  merchantId              String                @map("merchant_id") @db.Uuid
  itemId                  String                @map("item_id") @db.Uuid
  itemCodeSnapshot        String                @map("item_code_snapshot") @db.VarChar(40)
  itemNameSnapshot        String                @map("item_name_snapshot") @db.VarChar(200)
  kind                    StockMovementKind
  quantityDelta           Int                   @map("quantity_delta")
  actorId                 String                @map("actor_id") @db.Uuid
  actorNameSnapshot       String                @map("actor_name_snapshot") @db.VarChar(150)
  recordedAt              DateTime              @map("recorded_at") @db.Timestamptz(3)
  receiptLineId           String?               @unique @map("receipt_line_id") @db.Uuid
  adjustmentId            String?               @unique @map("adjustment_id") @db.Uuid
  shipmentLineId          String?               @unique @map("shipment_line_id") @db.Uuid
  shipmentDispatchId      String?               @map("shipment_dispatch_id") @db.Uuid
  shipmentLine            ShipmentLine?         @relation(fields: [shipmentLineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  shipmentDispatch        ShipmentDispatch?     @relation(fields: [shipmentDispatchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  warehouse               Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  merchant                Merchant              @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  item                    Item                  @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor                   User                  @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  receiptLine             ReceiptLine?          @relation("ReceiptLineMovement", fields: [receiptLineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  adjustment              StockAdjustment?      @relation("AdjustmentMovement", fields: [adjustmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  referencedByAdjustments StockAdjustment[]     @relation("AdjustmentReference")
  returnInspectionLineId  String?               @unique @map("return_inspection_line_id") @db.Uuid
  returnReviewId          String?               @unique @map("return_review_id") @db.Uuid
  returnInspectionLine    ReturnInspectionLine? @relation(fields: [returnInspectionLineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  returnReview            ReturnReview?         @relation(fields: [returnReviewId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, warehouseId, merchantId, itemId])
  @@index([warehouseId, merchantId, recordedAt, id])
  @@index([warehouseId, itemId, recordedAt, id])
  @@index([warehouseId, actorId, recordedAt, id])
  @@map("stock_movements")
}

// Immutable operation documents; state is derived from preparation/dispatch presence.
model Shipment {
  id                       String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId              String               @map("warehouse_id") @db.Uuid
  merchantId               String               @map("merchant_id") @db.Uuid
  code                     String               @db.VarChar(24)
  merchantNameSnapshot     String               @map("merchant_name_snapshot") @db.VarChar(200)
  registeredById           String               @map("registered_by_id") @db.Uuid
  registeredByNameSnapshot String               @map("registered_by_name_snapshot") @db.VarChar(150)
  registeredAt             DateTime             @map("registered_at") @db.Timestamptz(3)
  notes                    String?              @db.VarChar(2000)
  idempotencyKey           String               @map("idempotency_key") @db.Uuid
  requestHash              String               @map("request_hash") @db.Char(64)
  warehouse                Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  merchant                 Merchant             @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  registeredBy             User                 @relation("ShipmentRegistrar", fields: [registeredById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines                    ShipmentLine[]
  preparation              ShipmentPreparation?
  dispatch                 ShipmentDispatch?
  returns                  ReturnReceipt[]

  @@unique([warehouseId, idempotencyKey])
  @@unique([warehouseId, code])
  @@unique([id, warehouseId, merchantId])
  @@index([warehouseId, merchantId, registeredAt, id])
  @@index([warehouseId, registeredById, registeredAt, id])
  @@map("shipments")
}

model ShipmentLine {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId       String              @map("shipment_id") @db.Uuid
  warehouseId      String              @map("warehouse_id") @db.Uuid
  merchantId       String              @map("merchant_id") @db.Uuid
  itemId           String              @map("item_id") @db.Uuid
  position         Int
  itemCodeSnapshot String              @map("item_code_snapshot") @db.VarChar(40)
  itemNameSnapshot String              @map("item_name_snapshot") @db.VarChar(200)
  quantity         Int
  shipment         Shipment            @relation(fields: [shipmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  warehouse        Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  merchant         Merchant            @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  item             Item                @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  movement         StockMovement?
  returnLines      ReturnReceiptLine[]

  @@unique([shipmentId, position])
  @@unique([shipmentId, itemId])
  @@unique([id, warehouseId, merchantId, itemId])
  @@unique([id, shipmentId, warehouseId, merchantId, itemId], map: "shipment_line_return_scope_key")
  @@index([warehouseId, merchantId, itemId, shipmentId])
  @@map("shipment_lines")
}

model ShipmentCodeSequence {
  warehouseId String    @id @map("warehouse_id") @db.Uuid
  lastValue   BigInt    @default(0) @map("last_value")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("shipment_code_sequences")
}

model ShipmentPreparation {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId             String            @unique @map("shipment_id") @db.Uuid
  warehouseId            String            @map("warehouse_id") @db.Uuid
  merchantId             String            @map("merchant_id") @db.Uuid
  preparedById           String            @map("prepared_by_id") @db.Uuid
  preparedByNameSnapshot String            @map("prepared_by_name_snapshot") @db.VarChar(150)
  preparedAt             DateTime          @map("prepared_at") @db.Timestamptz(3)
  idempotencyKey         String            @map("idempotency_key") @db.Uuid
  requestHash            String            @map("request_hash") @db.Char(64)
  shipment               Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  warehouse              Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  merchant               Merchant          @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  preparedBy             User              @relation("ShipmentPreparer", fields: [preparedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dispatch               ShipmentDispatch?

  @@unique([warehouseId, idempotencyKey])
  @@unique([id, shipmentId, warehouseId, merchantId])
  @@index([warehouseId, merchantId, preparedAt, id])
  @@index([warehouseId, preparedById, preparedAt, id])
  @@map("shipment_preparations")
}

model ShipmentDispatch {
  id                       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId               String              @unique @map("shipment_id") @db.Uuid
  preparationId            String              @unique @map("preparation_id") @db.Uuid
  warehouseId              String              @map("warehouse_id") @db.Uuid
  merchantId               String              @map("merchant_id") @db.Uuid
  carrierName              String              @map("carrier_name") @db.VarChar(200)
  trackingNumber           String              @map("tracking_number") @db.VarChar(150)
  dispatchedById           String              @map("dispatched_by_id") @db.Uuid
  dispatchedByNameSnapshot String              @map("dispatched_by_name_snapshot") @db.VarChar(150)
  dispatchedAt             DateTime            @map("dispatched_at") @db.Timestamptz(3)
  idempotencyKey           String              @map("idempotency_key") @db.Uuid
  requestHash              String              @map("request_hash") @db.Char(64)
  shipment                 Shipment            @relation(fields: [shipmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  preparation              ShipmentPreparation @relation(fields: [preparationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  warehouse                Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  merchant                 Merchant            @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dispatchedBy             User                @relation("ShipmentDispatcher", fields: [dispatchedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  movements                StockMovement[]
  returns                  ReturnReceipt[]

  @@unique([warehouseId, idempotencyKey])
  @@unique([id, warehouseId, merchantId])
  @@unique([id, shipmentId, warehouseId, merchantId], map: "dispatch_return_scope_key")
  @@index([warehouseId, merchantId, dispatchedAt, id])
  @@index([warehouseId, dispatchedById, dispatchedAt, id])
  @@map("shipment_dispatches")
}

enum ReturnIssueType {
  BROKEN
  SCRATCH
  DAMAGED
  MISMATCH
  OTHER

  @@map("return_issue_type")
}

enum ReturnReviewDecision {
  ACCEPT_TO_STOCK
  REJECT_OUTSIDE_STOCK

  @@map("return_review_decision")
}

model ReturnReceipt {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId            String              @map("warehouse_id") @db.Uuid
  merchantId             String              @map("merchant_id") @db.Uuid
  shipmentId             String              @map("shipment_id") @db.Uuid
  dispatchId             String              @map("dispatch_id") @db.Uuid
  merchantNameSnapshot   String              @map("merchant_name_snapshot") @db.VarChar(200)
  shipmentCodeSnapshot   String              @map("shipment_code_snapshot") @db.VarChar(24)
  receivedById           String              @map("received_by_id") @db.Uuid
  receivedByNameSnapshot String              @map("received_by_name_snapshot") @db.VarChar(150)
  receivedAt             DateTime            @map("received_at") @db.Timestamptz(3)
  notes                  String?             @db.VarChar(2000)
  idempotencyKey         String              @map("idempotency_key") @db.Uuid
  requestHash            String              @map("request_hash") @db.Char(64)
  warehouse              Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  merchant               Merchant            @relation(fields: [merchantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  shipment               Shipment            @relation(fields: [shipmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dispatch               ShipmentDispatch    @relation(fields: [dispatchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  receiver               User                @relation("ReturnReceiver", fields: [receivedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines                  ReturnReceiptLine[]
  inspection             ReturnInspection?

  @@unique([warehouseId, idempotencyKey])
  @@unique([id, shipmentId, warehouseId, merchantId], map: "return_receipt_source_key")
