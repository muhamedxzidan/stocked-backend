# Local development only. Copy to .env and replace the placeholder password.
POSTGRES_USER=stocked_dev
POSTGRES_PASSWORD=REPLACE_WITH_YOUR_LOCAL_PASSWORD
POSTGRES_DB=stocked_dev
# URL-encode special characters in the password in this connection string.
DATABASE_URL="postgresql://stocked_dev:REPLACE_WITH_YOUR_LOCAL_PASSWORD@127.0.0.1:5432/stocked_dev?schema=public"
