# Local development only. Copy to .env and replace the placeholder password.
POSTGRES_USER=stocked_dev
POSTGRES_PASSWORD=REPLACE_WITH_YOUR_LOCAL_PASSWORD
POSTGRES_DB=stocked_dev
# URL-encode special characters in the password in this connection string.
DATABASE_URL="postgresql://stocked_dev:REPLACE_WITH_YOUR_LOCAL_PASSWORD@127.0.0.1:5432/stocked_dev?schema=public"

# Generate independently for each environment; keep identical across its server replicas.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_RATE_LIMIT_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Only list actual reverse proxy IPs/CIDRs; leave empty for direct local use.
TRUSTED_PROXIES=
AUTH_SESSION_SECONDS=43200
AUTH_IDLE_SECONDS=1800
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_ACCOUNT_ATTEMPTS=5
AUTH_IP_ATTEMPTS=20
